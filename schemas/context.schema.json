{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpm.local/engineering-os/schemas/context.schema.json",
  "title": "TaskContext",
  "description": "Context package tối thiểu cho MỘT task con (spec mục 7.2, 7.3). Worker chỉ nhận file này — không nhận toàn bộ plan/repo/conversation (INV-01).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "subTaskId", "objective", "constraints", "acceptanceCriteria", "verificationCriteria", "provenance"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "subTaskId": { "type": "string", "pattern": "^TASK-[0-9]{2,}$" },
    "objective": { "type": "string" },
    "files": {
      "type": "array",
      "description": "Chỉ file liên quan trực tiếp",
      "items": { "type": "string" }
    },
    "symbols": {
      "type": "array",
      "description": "Symbol kèm snippet đã cắt (không dump cả file)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string" },
          "lines": { "type": "string", "examples": ["120-168"] },
          "snippet": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "existingPattern": { "type": ["string", "null"] },
    "businessRules": {
      "type": "array",
      "description": "Rule nghiệp vụ liên quan (từ mcp-domain-core), phải kèm source",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verificationCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "unknowns": {
      "type": "array",
      "description": "Điều chưa xác định được. Không rỗng ⇒ cân nhắc BLOCKED thay vì đoán (INV-06).",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "object",
      "description": "Context đến từ đâu — trả lời được câu hỏi 'evidence/context này có nguồn gốc gì'",
      "additionalProperties": false,
      "required": ["generatedAt", "generatedBy"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatedBy": { "type": "string" },
        "gitSha": { "type": "string" },
        "planRef": { "type": "string" },
        "architectureRef": { "type": "string" },
        "mcpQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["server", "tool"],
            "properties": {
              "server": { "type": "string" },
              "tool": { "type": "string" },
              "args": { "type": "object" }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "Đo lường để giữ context nhỏ (spec mục 7.5)",
      "additionalProperties": false,
      "properties": {
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "maxTokenBudget": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean", "default": false }
      }
    }
  }
}
