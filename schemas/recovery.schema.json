{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpm.local/engineering-os/schemas/recovery.schema.json",
  "title": "RecoveryContext",
  "description": "Kết quả phân loại lỗi + recovery context tối thiểu (spec mục 15). Không chứa toàn bộ log hay toàn bộ context (INV-01).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "category",
    "confidence",
    "summary",
    "attempt",
    "maxAttempts",
    "autoRecoverable",
    "needsHuman",
    "targetStatus",
    "sourceStatus",
    "signals",
    "actions",
    "errorExcerpt",
    "createdAt",
    "createdBy",
    "truncated"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "subTaskId": { "type": "string", "pattern": "^TASK-[0-9]{2,}$" },
    "category": {
      "type": "string",
      "enum": [
        "COMPILE_ERROR",
        "TEST_FAILURE",
        "MISSING_CONTEXT",
        "MCP_FAILURE",
        "DESIGN_CONFLICT",
        "FILE_CONFLICT",
        "ENVIRONMENT_FAILURE",
        "UNKNOWN"
      ]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "summary": { "type": "string", "maxLength": 500 },
    "attempt": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "autoRecoverable": { "type": "boolean" },
    "needsHuman": { "type": "boolean" },
    "targetStatus": { "type": "string", "enum": ["DEBUGGING", "IMPLEMENTING", "BLOCKED"] },
    "sourceStatus": { "type": "string" },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "detail"],
        "properties": {
          "source": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "logRefs": { "type": "array", "items": { "type": "string" } },
    "contextRef": { "type": "string" },
    "expectedArtifactsMissing": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "errorExcerpt": {
      "type": "string",
      "description": "Trích lỗi tối thiểu (dòng đầu khớp + N dòng cuối stderr), không phải toàn bộ log"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "truncated": { "type": "boolean" }
  }
}
