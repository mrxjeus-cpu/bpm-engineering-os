      "summary": "Hạn mức theo thu nhập, không tài sản bảo đảm.",
      "inputs": [
        { "id": "CustomerFact", "type": "fact", "required": true, "source": "facts.json#CustomerFact" },
        { "id": "LoanFact", "type": "fact", "required": true, "source": "facts.json#LoanFact" },
        { "id": "CICFact", "type": "fact", "required": true, "source": "facts.json#CICFact" }
      ],
      "outputs": [{ "id": "MaxLoanAmount", "type": "number" }],
      "rules": [
        {
          "id": "CT1",
          "title": "Hạn mức theo thu nhập",
          "statement": "Hạn mức tối đa bằng 12 lần thu nhập hàng tháng.",
          "condition": "monthlyIncome > 0",
          "effect": "MaxLoanAmount = 12 * monthlyIncome",
          "tags": ["limit"],
          "source": "policies.json#POLICY-VAYTIEUTUNG/rules/CT1"
        },
        {
          "id": "CT2",
          "title": "Không có tài sản bảo đảm",
          "statement": "Sản phẩm tín chấp: không sử dụng tài sản bảo đảm trong tính toán.",
          "condition": "collateralType = NONE",
          "effect": "Không áp dụng LTV",
          "tags": ["structure"],
          "source": "policies.json#POLICY-VAYTIEUTUNG/rules/CT2"
        }
      ],
      "dependencies": [
